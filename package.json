{
  "name": "devin-battleship",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w @battleship/server\" \"npm run dev -w @battleship/client\"",
    "build": "npm run build -w @battleship/client",
    "start": "npm run start -w @battleship/server",
    "test": "npm run test -w @battleship/server",
    "test:e2e": "npm run test:e2e -w @battleship/server",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
